// coworks Prisma schema
// 로컬 PostgreSQL(localhost:5433) 기반. 차후 Supabase 이전 전제로 DATABASE_URL 환경변수 사용.
// 참고: ../CLAUDE.md (HanSpec 워크스페이스 구조)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: 연결 URL은 prisma.config.ts(CLI)와 PrismaClient 어댑터(런타임)에서 관리한다.
}

/// 스컬폴딩 단계의 연결 검증용 최소 모델.
/// 실제 MFR 도메인 모델은 다음 단계에서 추가한다.
model HealthCheck {
  id        String   @id @default(cuid())
  note      String   @default("ok")
  createdAt DateTime @default(now())
}

/// 멤버 등급. 가입 시 GENERAL로 고정, SUPER는 별도 승격.
/// 참조: docs/domain/02-member.md
enum MemberGrade {
  SUPER
  GENERAL
}

/// 프로젝트에 참여하는 멤버.
/// 참조: docs/domain/02-member.md
model Member {
  id        Int         @id @default(autoincrement())
  username  String      @unique @db.VarChar(20)
  password  String // bcrypt 해시 저장
  grade     MemberGrade @default(GENERAL)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  accessToken   AccessToken?
  assignedNodes NodeAssignee[]
}

/// 프로젝트 정보.
/// 참조: docs/domain/01-project.md
model Project {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  nodes       Node[]
}

/// 노드 레벨. 1단계 편집기는 MODULE만 다룬다.
/// 참조: docs/domain/04-node.md
enum NodeLevel {
  MODULE
  FEATURE
  REQUIREMENT
}

/// 노드 상태. 주로 REQUIREMENT에서 사용. (03-node.md 추가요청1)
enum NodeStatus {
  DRAFT // 초안
  IN_PROGRESS // 진행중
  DONE // 완료
}

/// 프로젝트의 작업 단위. parent_id self-reference 트리 구조.
/// 참조: docs/domain/04-node.md
model Node {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(255)
  level       NodeLevel
  description String?    @db.Text
  status      NodeStatus @default(DRAFT)
  parentId    Int? // self-ref. 최상위(MODULE)는 null
  projectId   Int
  version     Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent    Node?          @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Node[]         @relation("NodeChildren")
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  assignees NodeAssignee[]
}

/// 노드-담당자 다대다 조인. 우선 REQUIREMENT에만 지정. (03-node.md 추가요청2)
model NodeAssignee {
  nodeId     Int
  memberId   Int
  assignedAt DateTime @default(now())

  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([nodeId, memberId])
  @@map("node_assignee")
}

/// REQUIREMENT Node의 하위 작업.
/// 참조: docs/domain/06-task.md
model Task {
  id          Int      @id @default(autoincrement())
  progress    Int      @default(0) // 진행도 (0~100)
  description String   @db.Text
  nodeId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

/// 멤버가 로컬(CLI/MCP) 환경에서 사용할 액세스 토큰. 멤버당 1개.
/// 유효기간(7일)은 컬럼이 아니라 createdAt 기준으로 애플리케이션에서 파생 계산한다.
/// 참조: docs/domain/08-access_token.md
model AccessToken {
  id        Int      @id @default(autoincrement())
  token     String // 액세스 토큰 문자열 (제약 없음)
  createdAt DateTime @default(now()) // 발급일
  userId    Int      @unique // member.id FK, 1인 1토큰

  member Member @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("access_token")
}
