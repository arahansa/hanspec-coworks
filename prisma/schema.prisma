// coworks Prisma schema
// 로컬 PostgreSQL(localhost:5433) 기반. 차후 Supabase 이전 전제로 DATABASE_URL 환경변수 사용.
// 참고: ../CLAUDE.md (HanSpec 워크스페이스 구조)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: 연결 URL은 prisma.config.ts(CLI)와 PrismaClient 어댑터(런타임)에서 관리한다.
}

/// 스컬폴딩 단계의 연결 검증용 최소 모델.
/// 실제 MFR 도메인 모델은 다음 단계에서 추가한다.
model HealthCheck {
  id        String   @id @default(cuid())
  note      String   @default("ok")
  createdAt DateTime @default(now())
}

/// 멤버 등급. 가입 시 GENERAL로 고정, SUPER는 별도 승격.
/// 참조: docs/domain/02-member.md
enum MemberGrade {
  SUPER
  GENERAL
}

/// 프로젝트에 참여하는 멤버.
/// 참조: docs/domain/02-member.md
model Member {
  id        Int         @id @default(autoincrement())
  username  String      @unique @db.VarChar(20)
  password  String // bcrypt 해시 저장
  grade     MemberGrade @default(GENERAL)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  accessToken      AccessToken?
  assignedNodes    NodeAssignee[]
  projects         ProjectMember[]
  groups           MemberGroupParticipant[]
  sentRequests     RequestNotification[]    @relation("SentRequests")
  receivedRequests RequestNotification[]    @relation("ReceivedRequests")
  completeReservations CompleteNotification[]
  nodeMessages     NodeMessage[]
}

/// 프로젝트 정보.
/// 참조: docs/domain/01-project.md
model Project {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  nodes       Node[]
  tags        Tag[]
  environments Environment[]
  members     ProjectMember[]
  memberGroups MemberGroup[]
  slidePages   SlidePage[]
  slideSections SlideSection[]
}

/// 노드 레벨. 1단계 편집기는 MODULE만 다룬다.
/// 참조: docs/domain/04-node.md
enum NodeLevel {
  MODULE
  FEATURE
  REQUIREMENT
}

/// 노드 상태. 주로 REQUIREMENT에서 사용. (03-node.md 추가요청1)
enum NodeStatus {
  DRAFT // 초안
  IN_PROGRESS // 진행중
  DONE // 완료
}

/// 프로젝트의 작업 단위. parent_id self-reference 트리 구조.
/// 참조: docs/domain/04-node.md
model Node {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(255)
  level       NodeLevel
  description String?    @db.Text
  status      NodeStatus @default(DRAFT)
  completedAt DateTime?  // 마지막 DONE 전환 시각. DONE이 아니면 null. (03-node.md 추가기능)
  endpoint    String?    @db.VarChar(255) // FEATURE의 API 엔드포인트. (09-feature.md)
  parentId    Int? // self-ref. 최상위(MODULE)는 null
  projectId   Int
  version     Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent    Node?          @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Node[]         @relation("NodeChildren")
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  assignees NodeAssignee[]
  tags      NodeTag[]
  requests  RequestNotification[]
  completeTriggers CompleteNotification[] @relation("CompleteTrigger")
  completeTargets  CompleteNotification[] @relation("CompleteTarget")
  relationsA NodeRelation[] @relation("RelationA")
  relationsB NodeRelation[] @relation("RelationB")
  messages   NodeMessage[]
}

/// 요구사항 간 "관련" 연결. 무방향 — 항상 nodeAId < nodeBId로 정규화 저장하여
/// 한 행으로 양쪽 상세에서 보인다. 우선 같은 프로젝트의 REQUIREMENT끼리만 연결.
/// 관계 종류 구분은 차후 type 컬럼으로 확장. (관련 요구사항 설계 v1.0)
/// 참조: docs/superpowers/specs/2026-06-08-related-requirement-design.md
model NodeRelation {
  nodeAId   Int
  nodeBId   Int
  createdAt DateTime @default(now())

  nodeA Node @relation("RelationA", fields: [nodeAId], references: [id], onDelete: Cascade)
  nodeB Node @relation("RelationB", fields: [nodeBId], references: [id], onDelete: Cascade)

  @@id([nodeAId, nodeBId])
  @@index([nodeBId])
  @@map("node_relation")
}

/// 프로젝트 단위로 관리되는 태그. 같은 프로젝트 내에서 이름은 유일하다.
/// 자동완성 펼침목록은 프로젝트별로 모은다. (09-feature.md)
model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50)
  projectId Int
  createdAt DateTime @default(now())

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodes   NodeTag[]

  @@unique([projectId, name])
  @@map("tag")
}

/// 노드-태그 다대다 조인. 우선 FEATURE 노드에만 부여. (09-feature.md)
model NodeTag {
  nodeId Int
  tagId  Int

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([nodeId, tagId])
  @@map("node_tag")
}

/// 프로젝트별 환경변수. 저장소 위치 등을 기록한다. (07-environment.md)
/// .env에서 같은 이름으로 오버라이딩 가능(해석은 차후 과제).
/// 노드 설명의 `{{필드명}}`을 환경변수로 인식(치환은 차후 과제).
model Environment {
  id        Int    @id @default(autoincrement())
  name      String @db.VarChar(50) // 필드명
  value     String @db.VarChar(255) // 변수값
  projectId Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@map("environment")
}

/// 멤버-프로젝트 소속 다대다 조인. API 조회 시 소속 검증에 사용한다.
/// 참조: docs/superpowers/specs/2026-06-02-node-api-design.md
model ProjectMember {
  projectId Int
  memberId  Int
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([projectId, memberId])
  @@map("project_member")
}

/// 노드-담당자 다대다 조인. 우선 REQUIREMENT에만 지정. (03-node.md 추가요청2)
model NodeAssignee {
  nodeId     Int
  memberId   Int
  assignedAt DateTime @default(now())

  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([nodeId, memberId])
  @@map("node_assignee")
}

/// REQUIREMENT Node의 하위 작업.
/// 참조: docs/domain/06-task.md
model Task {
  id          Int      @id @default(autoincrement())
  progress    Int      @default(0) // 진행도 (0~100)
  description String   @db.Text
  name        String?  @db.VarChar(50) // 컴포넌트 이름 등. (06-task.md 추가요청)
  endpoint    String?  @db.VarChar(255) // 컴포넌트 경로/Endpoint. {{환경변수}} 사용 가능. (06-task.md)
  nodeId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

/// 프로젝트에 속한 멤버 그룹. 같은 프로젝트 내 멤버들을 묶는 단위.
/// 참조: docs/domain/10-user-group.md
model MemberGroup {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  projectId Int
  createdAt DateTime @default(now())

  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participants MemberGroupParticipant[]
  requests     RequestNotification[]
  completeReservations CompleteNotification[]

  @@map("member_group")
}

/// 멤버-그룹 참여 조인. 한 멤버가 같은 그룹에 중복 참여할 수 없다.
/// 참조: docs/domain/10-user-group.md
model MemberGroupParticipant {
  id       Int @id @default(autoincrement())
  groupId  Int
  memberId Int

  group  MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
  @@map("member_group_participant")
}

/// 요구사항(Node)에서 개인(receiver) 또는 그룹(group)에게 보내는 확인 요청.
/// receiverId/groupId 중 정확히 하나만 채워진다(개인 또는 그룹).
/// 요청을 받은 쪽이 확인하면 checked=true, checkedAt=확인 시각이 된다.
/// 참조: docs/domain/11-request-notification.md
model RequestNotification {
  id         Int       @id @default(autoincrement())
  senderId   Int // 요청을 보낸 멤버
  receiverId Int? // 개인 수신자(그룹 요청이면 null)
  groupId    Int? // 그룹 수신자(개인 요청이면 null)
  nodeId     Int // 요청 대상 요구사항 노드
  checked    Boolean   @default(false)
  checkedAt  DateTime?
  createdAt  DateTime  @default(now())

  sender   Member       @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver Member?      @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  group    MemberGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  node     Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([receiverId])
  @@index([groupId])
  @@index([senderId])
  @@map("request_notification")
}

/// 완료 알림 예약. triggerNode(요구사항)가 DONE이 되면, targetNode(같은 기능 내 다음 요구사항)에
/// 대한 확인 요청(RequestNotification)을 receiver/group에게 자동 발송한다.
/// receiverId/groupId 중 정확히 하나만 채워진다(개인 또는 그룹).
/// 참조: docs/domain/12-complete-notification.md
model CompleteNotification {
  id            Int  @id @default(autoincrement())
  triggerNodeId Int // 이 노드가 DONE이 되면 발송된다.
  targetNodeId  Int // 발송될 확인 요청이 가리키는 요구사항(다음 작업).
  receiverId    Int? // 개인 수신자(그룹 예약이면 null)
  groupId       Int? // 그룹 수신자(개인 예약이면 null)
  createdAt     DateTime @default(now())

  triggerNode Node         @relation("CompleteTrigger", fields: [triggerNodeId], references: [id], onDelete: Cascade)
  targetNode  Node         @relation("CompleteTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)
  receiver    Member?      @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  group       MemberGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([triggerNodeId])
  @@map("complete_notification")
}

/// 멤버가 로컬(CLI/MCP) 환경에서 사용할 액세스 토큰. 멤버당 1개.
/// 유효기간(7일)은 컬럼이 아니라 createdAt 기준으로 애플리케이션에서 파생 계산한다.
/// 참조: docs/domain/08-access_token.md
model AccessToken {
  id        Int      @id @default(autoincrement())
  token     String // 액세스 토큰 문자열 (제약 없음)
  createdAt DateTime @default(now()) // 발급일
  userId    Int      @unique // member.id FK, 1인 1토큰

  member Member @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("access_token")
}

/// 메시지 작성 주체. (01-talk-ai-user.md)
enum MessageRole {
  CLAUDE // 터미널 세션이 작성
  USER // 사람이 웹 UI에서 작성
}

/// 메시지 종류. (01-talk-ai-user.md)
enum MessageKind {
  QUESTION // CLAUDE가 막혀 던지는 질문 (options 동반 가능)
  ANSWER // USER가 QUESTION에 단 답
  INSTRUCTION // USER가 자발적으로 던지는 추가 지시
}

/// 메시지 상태. ANSWER는 상태 전이가 없어 null로 둔다. (01-talk-ai-user.md)
enum MessageStatus {
  PENDING // QUESTION: 답 대기 / INSTRUCTION: 픽업 대기
  ANSWERED // QUESTION: 답이 달림
  ACKNOWLEDGED // INSTRUCTION: Claude가 픽업함
}

/// 한 요구사항(Node) 아래의 양방향 대화 스레드.
/// 웹 UI(USER)와 터미널 세션(CLAUDE)이 비동기로 주고받는다.
/// 참조: docs/feature/01-talk-ai-user.md
model NodeMessage {
  id             Int            @id @default(autoincrement())
  nodeId         Int
  role           MessageRole
  kind           MessageKind
  status         MessageStatus? // ANSWER는 상태 전이 없음(null)
  body           String         @db.Text // 질문/답/지시 본문
  options        Json? // QUESTION의 선택지 배열
  selectedOption Int? // ANSWER가 고른 옵션 인덱스(자유입력이면 null)
  consumedAt     DateTime? // Claude가 픽업·처리한 시각 (중복 픽업 방지)
  parentId       Int? // ANSWER → 부모 QUESTION
  authorMemberId Int // 토큰 소유자(=작성 멤버)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  node    Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  parent  NodeMessage?  @relation("MessageReply", fields: [parentId], references: [id])
  replies NodeMessage[] @relation("MessageReply")
  author  Member        @relation(fields: [authorMemberId], references: [id])

  @@index([nodeId, createdAt])
  @@index([status])
  @@map("node_message")
}

/// 슬라이드 기획서의 논리적 페이지. 하나의 와이어프레임 페이지를 가리키며
/// 버전 이력(Slide[])을 가진다. 섹션(구역)으로 묶일 수 있다.
/// 참조: docs/superpowers/specs/2026-06-22-slides-design.md
model SlidePage {
  id        Int      @id @default(autoincrement())
  projectId Int
  title     String   @db.VarChar(255)
  position  Int      @default(0) // 프로젝트 내 정렬 순서
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions Slide[]
  sections SlideSectionPage[]

  @@index([projectId])
  @@map("slide_page")
}

/// 한 페이지(SlidePage)의 한 버전. document는 Excalidraw 장면(jsonb).
/// content(레거시 wiremd 본문)는 캔버스 전환 후 미사용 — nullable로 잔존.
/// 코멘트는 (1)(2) 마커가 버전별 내용이므로 버전(Slide)에 귀속된다.
/// 참조: docs/superpowers/specs/2026-07-02-slides-canvas-excalidraw-design.md
model Slide {
  id        Int      @id @default(autoincrement())
  pageId    Int
  version   Int // 페이지 내 버전 번호 (1부터)
  content   String?  @db.Text // 레거시(wiremd). 캔버스 슬라이드는 null.
  document  Json? // Excalidraw 장면 { elements, appState, files }. 빈 캔버스는 null.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page     SlidePage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  comments SlideComment[]

  @@unique([pageId, version])
  @@index([pageId])
  @@map("slide")
}

/// 페이지를 묶는 구역(섹션). 프로젝트 소속.
/// 참조: docs/superpowers/specs/2026-06-22-slides-design.md
model SlideSection {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String   @db.VarChar(255)
  position  Int      @default(0) // 프로젝트 내 정렬 순서
  createdAt DateTime @default(now())

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages   SlideSectionPage[]

  @@index([projectId])
  @@map("slide_section")
}

/// 섹션 ↔ 페이지 다대다 조인. 버전이 아닌 페이지 단위로 묶는다.
/// 참조: docs/superpowers/specs/2026-06-22-slides-design.md
model SlideSectionPage {
  id        Int @id @default(autoincrement())
  sectionId Int
  pageId    Int

  section SlideSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  page    SlidePage    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([sectionId, pageId])
  @@index([pageId])
  @@map("slide_section_page")
}

/// 슬라이드(버전) 내 (n)번 마커에 대한 설명. 우측 코멘트 패널에 표시.
/// 참조: docs/superpowers/specs/2026-06-22-slides-design.md
model SlideComment {
  id         Int      @id @default(autoincrement())
  slideId    Int
  commentNum Int // 슬라이드 내 코멘트 번호 (1, 2, 3...)
  comment    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  slide Slide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@unique([slideId, commentNum])
  @@index([slideId])
  @@map("slide_comment")
}
