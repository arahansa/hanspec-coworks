# coworks 환경 변수 예시
# 실제 값은 .env 에 작성한다 (.env 는 git에 커밋되지 않음)
#
# 로컬 개발: Docker postgres-common 컨테이너 (호스트 포트 5433)
# 차후 Supabase 이전 시 Supabase 프로젝트의 connection string으로 교체
DATABASE_URL="postgresql://postgres:postgres1234@localhost:5433/coworks?schema=public"

# 세션 쿠키 HMAC 서명 키. 운영 환경에서는 강한 무작위 값으로 교체할 것.
SESSION_SECRET="dev-only-change-me-please-32bytes-min-secret"
